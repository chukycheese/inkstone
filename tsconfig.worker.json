{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./node_modules/.tmp/tsc/worker",
    "tsBuildInfoFile": "./node_modules/.tmp/tsc/worker.tsbuildinfo",

    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["@cloudflare/workers-types"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/worker/**/*", "src/shared/**/*", "package.json"]
}
